{
  "name": "accountiva-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "vitest run",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:mobile:web": "pnpm --filter mobile start --web",
    "dev:web": "pnpm --filter web dev",
    "dev:react": "pnpm --filter web-react dev"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.5.2"
}
